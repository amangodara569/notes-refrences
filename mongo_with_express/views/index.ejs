<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>whatsapp chats</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h3>ALL CHATS</h3>
    <!-- for get request -->
     <!-- to define - request type and a route jispr get request jai gi -->
    <form method="GET" action="/chats/new">
        <button>new chat</button>
    </form>
    <br/>
    <% for (let chat of ourChats){ %>
     <div class="chat">
        <p>
            From : <%= chat.from %>
        </p>
        <p>
            <div class="msg">message : <%= chat.message %> <hr/>
                        To : <%= chat.to %></div>  
        </p>
        <form method="GET" action="/chats/<%= chat._id %>/edit">
            <button>edit</button>
        </form>
        <hr/>
        <p> <%= chat.created_at.toString().split(" ")[4] %></p>
        <p> <%= chat.created_at.toString().split(" ").slice(0,4).join("-") %></p>
     </div>
     <br/>
    <% } %>

</body>
</html>

