<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h3>write new chat</h3>
    <!-- we need to define request type and action post ke baad ye kidhar jana cahiye -->
    <form method="POST" action="/chats">
        <input placeholder="who are you" name="from"/>
        <br/>
        <textarea name="msg" placeholder="write your message here"></textarea>
        <br/>
        <input placeholder="add receiver" name="to"/>
        <br/>
        <button>create chat</button>
    </form>
</body>
</html>